# Database connection URL (PostgreSQL / SQLite fallback)
DATABASE_URL="your-database-url"

# Authentication secret for session token signing and user security
AUTH_SECRET="your-secret"

# Gemini / AI API Key for business advisory and DPR generation
AI_API_KEY="your-ai-key"
GEMINI_API_KEY="your-gemini-api-key"

# Map / GIS API Key for geographic boundary & district resource mapping
MAP_API_KEY="your-map-key"

# Application URL (injected by host or localhost in dev)
APP_URL="http://localhost:3000"
PORT=3000
NODE_ENV="development"
